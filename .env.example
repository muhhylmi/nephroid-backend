# Backend Environment Variables
# ------------------------------

# The port where the backend server will listen
PORT=8080

# PostgreSQL Database Connection String
# Format: postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://postgres:password@localhost:5432/nephroid?sslmode=disable

# Gemini API Key (Required for RAG embeddings and generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face API (Used for Vector Embeddings)
HF_API_KEY=your_hf_api_key_here
HF_EMBEDDING_MODEL_URL=https://api-inference.huggingface.co/pipeline/feature-extraction/sentence-transformers/all-MiniLM-L6-v2

# Qdrant Database Configuration (Supports Local and qdrant.io Cloud)
# For local Docker, leave host as localhost and port 6334
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_VECTOR_SIZE=384

# For Qdrant Cloud (qdrant.io), provide your cluster URL, API key, and enable TLS
# QDRANT_HOST=xxxxxxx.eu-central.aws.cloud.qdrant.io
# QDRANT_PORT=6334
# QDRANT_API_KEY=your_qdrant_cloud_api_key_here
# QDRANT_USE_TLS=true

# JWT Secret Key (Required for Authentication)
# If not set, defaults to "default_secret_for_dev_only"
# JWT_SECRET=your_jwt_secret_here
